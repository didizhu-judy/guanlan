# ============================================================
# 观澜 Guānlán · 环境变量模板
# ------------------------------------------------------------
# 把这个文件复制成 .env，再填入你的真实凭据：
#     cp .env.example .env
#
# .env 已经在 .gitignore 里，不会被 push 到 GitHub。
# ============================================================


# ---- 必需 ----------------------------------------------------
# Trading 212 API（HTTP Basic Auth：Key ID 是 username，Secret 是 password）
# 生成地址：https://www.trading212.com/  →  Settings → API → Generate new key
# 仅勾选只读权限（account.read / portfolio.read / history.read）
TRADING212_API_KEY_ID=
TRADING212_API_SECRET=

# live = 实盘  /  demo = 模拟盘
TRADING212_ENV=live

# 上面这把 key 对应的账户名（页面顶部的账户切换里显示），默认 ISA
# TRADING212_LABEL=ISA

# ---- 可选：第二个账户（T212 的 key 按账户分开生成：ISA 和 Invest 各一把）----
# 在 T212 App 里切到 Invest 账户再生成 key；填好保存后观澜自动检测，无需重启。
# 其它名字也行：TRADING212_<NAME>_API_KEY_ID / _SECRET（可选 _LABEL / _ENV）
TRADING212_INVEST_API_KEY_ID=
TRADING212_INVEST_API_SECRET=


# ---- 可选：AI 分析（缺失则聊天框灰显，其余功能不受影响） -----
# 默认使用 Codex CLI；可改成 claude / echo / 任何二进制
AGENT_CMD=codex


# ---- 可选：消息面 / 单股报价（缺失则消息面 Tab 显示「未配置」）
# 注册地址：https://finnhub.io/ （免费 60 calls/min）
FINNHUB_API_KEY=

# ---- 可选：期权链/未平仓(OI) → 期权上下限面板(Call墙/Put墙)
# 留空则回退到 yfinance(OI 时有时无、不可靠)。填了就用 marketdata.app(稳)。
# 注册地址：https://www.marketdata.app/ （免费档，邮箱/GitHub 一键注册即出 token）
MARKETDATA_API_TOKEN=


# ---- 可选：技术触发监控 → 飞书推送（tech_monitor.py 用） --------
# 飞书群 → 设置 → 群机器人 → 添加「自定义机器人」→ 复制 Webhook 地址。
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_WEBHOOK=
# 若机器人勾选了「签名校验」，把那串密钥填这里；没开就留空。
FEISHU_SECRET=


# ---- 可选：调优 ----------------------------------------------
# 后端监听端口，默认 8787，一般不需要改
# GUANLAN_PORT=8787

# 缓存 TTL（秒），默认 30；超过 TTL 失败时会用旧值兜底，不让前端断流
# CACHE_TTL=30
