<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.guanlan.crowding</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOUR_USERNAME/Library/guanlan/crowding_monitor.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/Library/guanlan</string>
  <!-- 每天 21:30 UK（盘后）跑 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/guanlan_crowding.log</string>
  <key>StandardErrorPath</key><string>/tmp/guanlan_crowding.err</string>
</dict>
</plist>
